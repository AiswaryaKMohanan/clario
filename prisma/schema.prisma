
generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native"]  // Ensures Prisma uses your OS binary

}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
}
